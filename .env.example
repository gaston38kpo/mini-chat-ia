# Copia este archivo a ".env" y descomenta/ajusta lo que necesites.
# Todas las variables son opcionales; sin ".env" se usan los defaults del codigo.

# URL base del backend de chat. Descomenta para pisar el default del codigo.
#   LM Studio nativo:  http://localhost:1234/api/v1
#   OpenAI-compatible: https://api.openai.com/v1
# VITE_API_BASE_URL=http://localhost:1234/api/v1

# Provider activo: lmstudio | openai-compatible
VITE_PROVIDER=lmstudio

# API key (solo backends que la requieren; dejar vacio si no aplica)
VITE_API_KEY=
